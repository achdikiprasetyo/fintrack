# ========================================================
# 🏛️ FINTRACK UNIVERSAL ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env: cp .env.example .env
# ========================================================

# --------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
# --------------------------------------------------------
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_public_key_here"
# Opsional: Jika menggunakan service role untuk bypass RLS
# SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# --------------------------------------------------------
# 2. AI MULTI-TRANSACTION & OCR (Google Gemini AI)
# Dapatkan gratis di Google AI Studio: https://aistudio.google.com
# Digunakan untuk OCR Resi/QRIS & AI Natural Language Parser
# --------------------------------------------------------
GOOGLE_API_KEY="your_google_ai_studio_api_key_here"

# --------------------------------------------------------
# 3. TELEGRAM BOT NOTIFICATIONS & WIZARD (Opsional)
# - TELEGRAM_BOT_TOKEN: Dapatkan via @BotFather di Telegram
# - ALLOWED_TELEGRAM_USER_ID: Dapatkan ID numerik via @userinfobot
#   (PENTING: Hanya ID ini yang diizinkan mengelola keuangan)
# --------------------------------------------------------
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
ALLOWED_TELEGRAM_USER_ID="your_telegram_numeric_id_here"

# --------------------------------------------------------
# 4. DISCORD WEBHOOK INTEGRATION (Opsional)
# Dapatkan dari Discord: Channel Settings -> Integrations -> Webhooks
# Mengirim notifikasi transaksi & sinkronisasi harga pasar
# Kosongkan jika tidak menggunakan Discord.
# --------------------------------------------------------
DISCORD_WEBHOOK_URL=""

# --------------------------------------------------------
# 5. SERVER & APPLICATION CONFIGURATION
# --------------------------------------------------------
PORT=8081
APP_NAME="FinTrack"
CURRENCY="IDR"

# --------------------------------------------------------
# 6. NETWORK PROXY (Opsional - Jika server berada di area geoblocking)
# --------------------------------------------------------
# ALL_PROXY="socks5h://127.0.0.1:40000"
# NO_PROXY="localhost,127.0.0.1"
